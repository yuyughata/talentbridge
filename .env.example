# ---------------------------------------------------------------------------
# Talent Bridge Africa — environment variables
# Copy to `.env.local` for local development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase service role — SERVER ONLY. Never expose to the browser.
# Used by trusted server actions / verification workflows that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (used for auth redirects, invitation links, email callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email provider (invitations, verification, access requests) — §7
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@talentbridge.africa

# Dedicated video provider (match footage upload/transcoding/playback) — §7, M06
# e.g. Mux, Cloudflare Stream. Do NOT store large video in Postgres.
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_ENV=

# Monitoring / error tracking (§7)
SENTRY_DSN=
